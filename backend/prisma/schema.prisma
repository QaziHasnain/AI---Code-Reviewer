// Score constraint (0–100) will be added through
// a custom SQL migration after table creation.
// SQL statements must not be placed inside this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String       @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviews      CodeReview[]
  sessions     Session[]
}

// CodeReview Model
model CodeReview {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  sourceCode          String              @db.Text
  programmingLanguage ProgrammingLanguage
  reviewStatus        ReviewStatus        @default(PENDING)
  repository          String?
  branch              String?
  commitHash          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  results             ReviewResult[]

  @@index([userId, createdAt])
}

// ReviewResult Model
model ReviewResult {
  id                   String        @id @default(uuid()) @db.Uuid
  codeReviewId         String        @db.Uuid
  outcome              ReviewOutcome
  score                Int
  summary              String
  detailedAnalysis     String?
  aiProvider           String
  aiModel              String
  promptTokenUsage     Int
  completionTokenUsage Int
  processingDuration   Int
  createdAt            DateTime      @default(now())
  codeReview           CodeReview    @relation(fields: [codeReviewId], references: [id], onDelete: Cascade)
  issues               ReviewIssue[]

  @@index([codeReviewId, createdAt])
}

// ReviewIssue Model
model ReviewIssue {
  id             String        @id @default(uuid()) @db.Uuid
  reviewResultId String        @db.Uuid
  title          String
  description    String
  severity       IssueSeverity
  type           IssueType
  status         IssueStatus   @default(OPEN)
  filePath       String?
  lineStart      Int?
  lineEnd        Int?
  startColumn    Int?
  endColumn      Int?
  suggestedFix   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reviewResult   ReviewResult  @relation(fields: [reviewResultId], references: [id], onDelete: Cascade)

  @@index([reviewResultId, severity])
}

// Session Model
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
  userAgent  String?
  ipHash     String?

  @@index([userId])
  @@index([expiresAt])
}

// Native PostgreSQL Prisma Enums
enum ProgrammingLanguage {
  TYPESCRIPT
  JAVASCRIPT
  PYTHON
  JAVA
  CPP
  CSHARP
  GO
  RUST
  RUBY
  PHP
  SWIFT
  KOTLIN
  R
  MATLAB
  SCALA
  HASKELL
  ELM
  OCAML
  PERL
  LUA
  DART
}

enum ReviewStatus {
  PENDING
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewOutcome {
  PASS
  FAIL
  NEEDS_REVIEW
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  SECURITY
  PERFORMANCE
  STYLE
  LOGIC
  TYPE_SAFETY
  DOCUMENTATION
  TESTING
  MAINTAINABILITY
}

enum IssueStatus {
  OPEN
  FIXED
  IGNORED
}
